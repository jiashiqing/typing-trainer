# ============================================================
#  行尾策略：由仓库说了算，不跟着每个人的 core.autocrlf 漂
#
#  为什么必须写这个文件：
#    Windows 上 git 默认 autocrlf=true，会把脚本检出成 CRLF。
#    服务器是 Linux，bash 遇到 CRLF 会报 $'\r': command not found，
#    而且报错信息完全看不出是行尾问题。
#
#  规则：一律 LF，只有 Windows 批处理用 CRLF。
# ============================================================

* text=auto eol=lf

# Linux 上直接执行的东西，必须是 LF
*.sh      text eol=lf
*.service text eol=lf
*.conf    text eol=lf

# Windows 批处理（cmd 对 LF 的容忍度不如 CRLF）
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 源码与文档
*.js      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# 二进制，别做任何转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.xlsx    binary
*.zip     binary
*.sqlite  binary
