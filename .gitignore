# ============================================================
#  打字练习系统 · Git 忽略规则
#  原则：能装进数据库的、能从依赖装回来的、能重新生成的，都不入库
# ============================================================

# ---- 运行时数据（最重要）----
# data/ 里是 db.sqlite，全校学生的姓名和成绩。绝不入库。
# 服务器上这个目录独立存在，部署脚本（pull-deploy.sh）全程不碰它。
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ---- 依赖 ----
# 由 npm install / pip install 现场装，跨平台拷来拷去反而容易坏
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# ---- 备份与临时产物 ----
# 部署前自动备份的库、调试截图、Edge 无头浏览器临时目录
_backup_*/
_edgetmp*/
*.log
*.tmp
*.bak

# ---- 部署运行时状态 ----
# pull-deploy.sh 写在这里：当前版本、部署历史。属于服务器本地状态，不入库
.deploy/

# ---- 文档截图 ----
# 3.8 MB 的 PNG，只有看文档时才用得上，部署时纯属白拉一遍。
# 需要归档就单独存网盘，不进版本库。
预览截图/

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
